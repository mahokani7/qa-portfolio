# [선택] 알림 전달 채널(Slack/이메일) 자동 프로비저닝 템플릿
# ---------------------------------------------------------------------------
# 알림 '규칙'은 rules.yaml로 이미 적용되어 Grafana Alerting 화면에서 상태(Normal/Firing)를 볼 수 있습니다.
# 실제 Slack/이메일 '전달'까지 원하면, 이 파일을 contactpoints.yaml 로 복사하고 아래 값을 채운 뒤
# `docker compose up -d --force-recreate grafana` 하세요. (본인 Slack Webhook URL 필요)
#
# Slack Webhook 발급: Slack → Apps → Incoming Webhooks → Add to Slack → 채널 선택 → URL 복사
apiVersion: 1

contactPoints:
  - orgId: 1
    name: slack-notifications
    receivers:
      - uid: slack-receiver
        type: slack
        settings:
          url: "https://hooks.slack.com/services/여기에/본인/WEBHOOK-URL"
          title: "{{ .CommonLabels.severity | toUpper }} · {{ .CommonAnnotations.summary }}"
          text: "{{ range .Alerts }}• {{ .Labels.alertname }} ({{ .Labels.severity }})\n{{ .Annotations.summary }}\n{{ end }}"

# 위 contactPoint로 모든 알림을 보내려면 아래 정책도 함께 활성화하세요.
policies:
  - orgId: 1
    receiver: slack-notifications
    group_by: ["alertname"]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
