{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "k6 성능 테스트 결과",
  "uid": "k6-performance",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "총 HTTP 요청 수 (k6)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "k6_http_reqs_total", "refId": "A", "legendFormat": "requests" }
      ]
    },
    {
      "id": 2,
      "title": "오류율 (http_req_failed)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] } } },
      "targets": [
        { "expr": "k6_http_req_failed_rate", "refId": "A", "legendFormat": "fail rate" }
      ]
    },
    {
      "id": 3,
      "title": "p95 응답시간 (ms)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1000 } ] } } },
      "targets": [
        { "expr": "k6_http_req_duration_p95", "refId": "A", "legendFormat": "p95" }
      ]
    },
    {
      "id": 4,
      "title": "가상 사용자 수 (VUs)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "k6_vus", "refId": "A", "legendFormat": "VUs" }
      ]
    },
    {
      "id": 5,
      "title": "응답시간 추이 (avg / p95 / max, ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "expr": "k6_http_req_duration_avg", "refId": "A", "legendFormat": "avg" },
        { "expr": "k6_http_req_duration_p95", "refId": "B", "legendFormat": "p95" },
        { "expr": "k6_http_req_duration_max", "refId": "C", "legendFormat": "max" }
      ]
    },
    {
      "id": 6,
      "title": "초당 요청률 & 체크 성공률",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "rate(k6_http_reqs_total[1m])", "refId": "A", "legendFormat": "req/s" },
        { "expr": "k6_checks_rate", "refId": "B", "legendFormat": "check success rate" }
      ]
    }
  ]
}
