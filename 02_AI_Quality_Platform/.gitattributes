# Keep text files consistent across Windows, macOS, and Linux.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary documents and images
*.pdf binary
*.docx binary
*.xlsx binary
*.xls binary
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary

